{
  "name": "perlica",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Perlica - Personal AI Agent Desktop Harness",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@perlica/desktop",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "verify:architecture": "node scripts/verify-architecture.js",
    "lint": "node scripts/verify-architecture.js && eslint .",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\""
  },
  "keywords": [
    "ai",
    "agent",
    "harness",
    "desktop",
    "tauri",
    "perlica"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "typescript-eslint": "^8.70.0"
  }
}
